{
  "name": "code3d-packages",
  "private": true,
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "scripts": {
    "3": "npm install && npm dedupe && npm install",
    "clean": "rimraf dist --glob packages/*/{.cache,bld,dist}",
    "build:packages": "tsc --build",
    "build": "npm run lint-prettier && npm run clean && npm run build:packages && npm run build --workspace @code3d/app",
    "dev": "npm run build:packages && npm run dev --workspace @code3d/app",
    "lint-prettier": "prettier --check .",
    "format": "prettier --write .",
    "app": "npm run --workspace @code3d/app",
    "core": "npm run --workspace @code3d/core",
    "screws": "npm run --workspace @code3d/screws"
  },
  "workspaces": [
    "packages/app",
    "packages/core",
    "packages/screws"
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
