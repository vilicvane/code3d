{
  "name": "@code3d/cli",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "c3d": "bld/main.js"
  },
  "files": [
    "bld",
    "README.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs",
    "test": "npm run build && npm run test:types && npm run test:run",
    "build": "node ../../node_modules/typescript/bin/tsc --build",
    "test:types": "node ../../node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json",
    "test:run": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@code3d/agent": "0.0.1-alpha.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
