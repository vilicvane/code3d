{
  "name": "@code3d/cli",
  "version": "0.0.1-alpha.2",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "c3d": "bld/main.js"
  },
  "files": [
    "bld",
    "README.md",
    "src"
  ],
  "scripts": {
    "prepack": "npm run build",
    "test": "npm run build && npm run test:types && npm run test:run",
    "build": "node ../../scripts/build-packages.mjs @code3d/cli",
    "test:types": "node ../../node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json",
    "test:run": "node --import ../../test/source-loader.mjs --test --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "@code3d/agent": "0.0.1-alpha.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "commander": "^15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vilicvane/code3d.git",
    "directory": "packages/cli"
  }
}
