{
  "name": "@code3d/solver",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "license": "LGPL-2.1-or-later",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./wasm/solver.js"
    },
    "./wasm": "./wasm/solver.wasm"
