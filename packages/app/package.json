{
  "name": "@code3d/app",
  "version": "0.0.1-alpha.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs",
    "dev": "vite",
    "build": "node ../../node_modules/typescript/bin/tsc --noEmit && vite build",
    "test": "npm run test:types && npm run test:run",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.{mjs,ts}\"",
    "test:browser:tool-panel": "node --test test/browser/contextual-tool-panel.test.mjs",
    "preview": "vite preview",
    "render-image": "node scripts/render-image.mjs",
    "test:run": "node --test \"test/*.test.ts\"",
    "test:types": "node ../../node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@code3d/core": "*",
    "@code3d/screws": "*",
    "@headless-tree/core": "^1.7.0",
    "@typescript/typescript6": "^6.0.2",
    "@zenfs/core": "^2.7.0",
    "@zenfs/dom": "^1.2.12",
    "enhanced-resolve": "^5.24.5",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.2",
    "lucide": "^1.41.0",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "replicad": "^1.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@typescript/old": "npm:typescript@^6",
    "esbuild": "^0.28.2",
    "just-range": "4.2.0",
    "playwright-core": "^1.58.2",
    "vite": "^8.2.2"
  }
}
