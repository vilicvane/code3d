---
import ArrowUpRight from '../assets/icons/arrow-up-right.svg';
import '../styles/icons.css';

interface Props {
  direction?: 'up-right' | 'up' | 'down-left';
}
const {direction = 'up-right'} = Astro.props;
---

<ArrowUpRight
  class="c3-arrow"
  data-direction={direction}
  aria-hidden="true"
  focusable="false"
/>
