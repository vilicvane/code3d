---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';

const metadata = Astro.locals.starlightRoute.entry.data.package;
---

<PageTitle />
{
  metadata && (
    <p class="package-version">
      {Astro.locals.starlightRoute.entry.data.title !== metadata.name && (
        <span>{metadata.name}</span>
      )}
      <span>v{metadata.version}</span>
    </p>
  )
}

<style>
  .package-version {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-system-mono);
    font-size: var(--sl-text-sm);
  }
</style>
