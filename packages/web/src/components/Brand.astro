---
import {sitePath} from '../lib/site';
---

<a class="c3-brand" href={sitePath('')} aria-label="Code3D home">
  <svg aria-hidden="true" viewBox="0 0 32 32"
    ><path d="M16 2 30 16 16 30 2 16Z"></path><path d="m16 9 7 7-7 7-7-7Z"
    ></path></svg
  >
  <span>Code3D</span>
</a>
<style>
  .c3-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: var(--c3-accent, #d8ff3e);
    stroke-width: 2.2;
  }
</style>
