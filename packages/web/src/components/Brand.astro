---
import {sitePath} from '../lib/site';
import mark from '../../../../assets/brand/mark.svg?raw';
---

<a class="c3-brand" href={sitePath('')} aria-label="Code3D home">
  <span class="c3-brand-mark" aria-hidden="true" set:html={mark} />
  <span>Code3D</span>
</a>
<style>
  .c3-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .c3-brand-mark {
    display: flex;
    width: 28px;
    height: 21px;
  }
  .c3-brand-mark :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
