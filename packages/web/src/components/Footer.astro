---
import Brand from './Brand.astro';
import ArrowIcon from './ArrowIcon.astro';
import {githubUrl, sitePath} from '../lib/site';
---

<footer class="site-footer shell">
  <div><Brand /><p>Code and geometry, connected.</p></div>
  <nav aria-label="Footer navigation">
    <a href={sitePath('docs/')}>Documentation</a>
    <a href={githubUrl}>GitHub <ArrowIcon /></a>
    <a href={sitePath('docs/reference/limitations/')}>Prototype 01</a>
    <a href={sitePath('license.txt')}>Community License</a>
  </nav>
</footer>
