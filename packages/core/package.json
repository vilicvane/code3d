{
  "name": "@code3d/core",
  "version": "0.0.1-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "vilicvane",
  "type": "module",
  "scripts": {
    "prepack": "npm run build",
    "test": "npm run build && npm run test:types && npm run test:run",
    "test:run": "node --import ../../test/source-loader.mjs --test --test-concurrency=1 \"test/*.test.{mjs,ts}\"",
    "test:types": "node ../../node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json",
    "build": "node ../../scripts/build-packages.mjs @code3d/core"
  },
  "exports": {
    ".": {
      "types": "./bld/library/index.d.ts",
      "node": "./bld/node/index.js",
      "browser": "./bld/library/index.js",
      "default": "./bld/library/index.js"
    },
    "./replicad": {
      "types": "./bld/library/replicad.d.ts",
      "node": "./bld/node/replicad.js",
      "browser": "./bld/library/replicad.js",
      "default": "./bld/library/replicad.js"
    },
    "./tooling": {
      "types": "./bld/tooling/index.d.ts",
      "default": "./bld/tooling/index.js"
    },
    "./three": {
      "types": "./bld/library/three.d.ts",
      "default": "./bld/library/three.js"
    }
  },
  "files": [
    "bld",
    "THIRD_PARTY.md",
    "README.md",
    "src"
  ],
  "dependencies": {
    "@code3d/opencascade": "0.0.1-alpha.0",
    "@salusoft89/planegcs": "1.2.0",
    "@types/emscripten": "1.41.5",
    "@types/three": "^0.185.4",
    "harfbuzzjs": "1.6.1",
    "manifold-3d": "3.0.1",
    "replicad": "^1.0.1",
    "replicad-opencascadejs": "1.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "flo-boolean": "5.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vilicvane/code3d.git",
    "directory": "packages/core"
  }
}
