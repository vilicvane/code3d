{
  "name": "@code3d/core",
  "version": "0.0.1-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "vilicvane",
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs",
    "test": "node ../../node_modules/typescript/bin/tsc --build src/library/tsconfig.json src/node/tsconfig.json src/tooling/tsconfig.json && npm run test:types && npm run test:run",
    "test:run": "node --test \"test/*.test.{mjs,ts}\"",
    "test:types": "node ../../node_modules/typescript/bin/tsc --noEmit -p test/tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./bld/library/index.d.ts",
      "node": "./bld/node/index.js",
      "browser": "./bld/library/index.js",
      "default": "./bld/library/index.js"
    },
    "./replicad": {
      "types": "./bld/library/replicad.d.ts",
      "node": "./bld/node/replicad.js",
      "browser": "./bld/library/replicad.js",
      "default": "./bld/library/replicad.js"
    },
    "./tooling": {
      "types": "./bld/tooling/index.d.ts",
      "default": "./bld/tooling/index.js"
    }
  },
  "files": [
    "bld",
    "THIRD_PARTY.md",
    "README.md"
  ],
  "dependencies": {
    "@code3d/opencascade": "0.0.1-alpha.0",
    "@salusoft89/planegcs": "1.2.0",
    "replicad": "^1.0.1",
    "replicad-opencascadejs": "1.0.0"
  }
}
